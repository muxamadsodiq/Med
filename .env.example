# Telegram Bot Token (get it from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Telegram Channel ID where signals will be posted (e.g. @MySignalChannel or -100XXXXXXXXXX)
TELEGRAM_CHANNEL_ID=@your_channel_id

# Comma-separated list of ticker symbols to monitor
# Crypto examples: BTC-USD, ETH-USD, BNB-USD
# Stock examples: AAPL, TSLA, MSFT
WATCHLIST=BTC-USD,ETH-USD,BNB-USD,SOL-USD,XRP-USD

# How often to check for signals (in minutes)
SIGNAL_INTERVAL_MINUTES=30

# RSI thresholds for oversold/overbought signals
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70

# Minimum signal strength (0.0 – 1.0) required before posting to the channel
MIN_SIGNAL_STRENGTH=0.6
